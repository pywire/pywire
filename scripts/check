#!/bin/sh -e

# Graph-driven: iterate units in topological order (grammar/parser before
# consumers). New packages are orchestrated automatically.
#
# --changed [base-ref]: check only the units affected by the working tree /
# branch diff (changed units plus everything downstream).

if [ "$1" = "--changed" ]; then
  shift
  units=$(python3 scripts/monorepo_graph.py affected "$@")
  if [ -z "$units" ]; then
    echo "No affected units — nothing to check."
    exit 0
  fi
else
  units=$(python3 scripts/monorepo_graph.py units)
fi

for unit in $units; do
  echo "=== Checking $unit ==="
  (cd "$unit" && ./scripts/check)
done
