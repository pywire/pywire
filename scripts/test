#!/bin/sh -e

# Tests for every unit that exposes scripts/test, in topological order.
# Units without scripts/test are skipped (granular entry points are
# optional per the AGENTS.md tooling contract).

for unit in $(python3 scripts/monorepo_graph.py units); do
  if [ -x "$unit/scripts/test" ]; then
    echo "=== Testing $unit ==="
    (cd "$unit" && ./scripts/test "$@")
  fi
done
