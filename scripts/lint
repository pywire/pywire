#!/bin/sh -e

# Lint (format + lint) for every unit that exposes scripts/lint, in
# topological order. Units without scripts/lint are skipped (granular
# entry points are optional per the AGENTS.md tooling contract).

for unit in $(python3 scripts/monorepo_graph.py units); do
  if [ -x "$unit/scripts/lint" ]; then
    echo "=== Linting $unit ==="
    (cd "$unit" && ./scripts/lint)
  fi
done
