---
import type { Props } from '@astrojs/starlight/props'
import config from 'virtual:starlight/user-config'

const links = config.social ?? []
---

{
  links.length > 0 && (
    <div class="social-icons">
      {links.map((link) => {
        const isDiscord = link.icon === 'discord' || /discord/i.test(link.href)
        return (
          <a href={link.href} rel="me" class="sl-flex social-icon" aria-label={link.label}>
            {isDiscord ? (
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            ) : (
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            )}
          </a>
        )
      })}
    </div>
  )
}

<style>
  .social-icons {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
  }

  .social-icon {
    color: var(--pywire-fg-muted);
    align-items: center;
    justify-content: center;
    transition: color var(--pywire-motion-fast) var(--pywire-ease-spring);
  }

  .social-icon:hover,
  .social-icon:focus-visible {
    color: var(--pywire-accent);
  }

  .social-icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }
</style>
