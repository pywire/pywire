---
import PywireGlyph from '../../../assets/brand/pywire-glyph.svg';
---

<a href={import.meta.env.BASE_URL} class="site-title sl-flex" aria-label="pywire — home">
  <span class="logo-chip" aria-hidden="true">
    <PywireGlyph class="logo-mark" preserveAspectRatio="xMidYMid meet" width="100%" height="100%" />
  </span>
  <span class="logo-wordmark">pywire</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.625rem;
    color: var(--pywire-accent);
    text-decoration: none;
    font-family: var(--pywire-font-mono);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    transition: color var(--pywire-motion-fast) var(--pywire-ease-spring);
    overflow: hidden;
    white-space: nowrap;
  }

  .logo-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 7px;
    padding: 4px;
    box-sizing: border-box;
    background: color-mix(in oklch, var(--pywire-accent) 8%, transparent);
    border: 1.5px solid color-mix(in oklch, var(--pywire-accent) 30%, transparent);
    flex-shrink: 0;
  }

  :root[data-theme='dark'] .logo-chip {
    background: color-mix(in oklch, var(--pywire-accent) 10%, transparent);
    box-shadow:
      0 0 8px color-mix(in oklch, var(--pywire-accent) 30%, transparent),
      inset 0 0 5px color-mix(in oklch, var(--pywire-accent) 18%, transparent);
  }

  .logo-mark {
    width: 100%;
    height: 100%;
    display: block;
  }

  :root[data-theme='dark'] .logo-mark {
    filter: drop-shadow(0 0 3px color-mix(in oklch, var(--pywire-accent) 50%, transparent));
  }

  .logo-wordmark {
    color: var(--pywire-accent);
    text-shadow: 0 0 8px color-mix(in oklch, var(--pywire-accent) 22%, transparent);
  }

  .site-title:hover,
  .site-title:focus-visible {
    color: var(--pywire-accent-hover);
  }
</style>
