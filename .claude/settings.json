{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/hooks/pre-git-check.sh\"",
            "timeout": 900,
            "statusMessage": "Running checks before commit..."
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/hooks/pre-git-check.sh\"",
            "timeout": 900,
            "statusMessage": "Running checks before push..."
          }
        ]
      }
    ]
  }
}
