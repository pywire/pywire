{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "always-update": true,
  "packages": {
    "packages/pywire": {
      "release-type": "python",
      "component": "pywire",
      "extra-files": ["Cargo.toml", "src/pywire/client/package.json"]
    },
    "packages/pywire-language-server": {
      "release-type": "python",
      "component": "pywire-language-server"
    },
    "packages/tree-sitter-pywire": {
      "release-type": "node",
      "component": "tree-sitter-pywire",
      "extra-files": ["Cargo.toml"]
    },
    "packages/vscode-pywire": {
      "release-type": "node",
      "component": "vscode-pywire"
    },
    "packages/prettier-plugin-pywire": {
      "release-type": "node",
      "component": "prettier-plugin-pywire"
    },
    "packages/create-pywire-app": {
      "release-type": "python",
      "component": "create-pywire-app"
    },
    "docs": {
      "release-type": "node",
      "component": "pywire-docs"
    }
  }
}
