{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "always-update": true,
  "packages": {
    "packages/pywire": {
      "release-type": "python",
      "component": "pywire",
      "extra-files": ["src/pywire/client/package.json"]
    },
    "packages/pywire-parser": {
      "release-type": "python",
      "component": "pywire-parser"
    },
    "packages/pywire-auth": {
      "release-type": "python",
      "component": "pywire-auth"
    },
    "packages/pywire-secure": {
      "release-type": "python",
      "component": "pywire-secure"
    },
    "packages/pywire-cli": {
      "release-type": "python",
      "component": "pywire-cli"
    },
    "packages/pywire-templates": {
      "release-type": "python",
      "component": "pywire-templates"
    },
    "packages/pywire-language-server": {
      "release-type": "python",
      "component": "pywire-language-server"
    },
    "packages/tree-sitter-pywire": {
      "release-type": "python",
      "component": "tree-sitter-pywire",
      "extra-files": ["package.json", "Cargo.toml"]
    },
    "packages/vscode-pywire": {
      "release-type": "node",
      "component": "vscode-pywire"
    },
    "packages/prettier-plugin-pywire": {
      "release-type": "node",
      "component": "prettier-plugin-pywire"
    },
    "packages/create-pywire-app": {
      "release-type": "python",
      "component": "create-pywire-app"
    },
    "docs": {
      "release-type": "node",
      "component": "pywire-docs"
    }
  }
}
