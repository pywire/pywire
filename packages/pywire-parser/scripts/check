#!/bin/sh
set -e

echo "🔍 Running checks for pywire-parser..."

echo "-> ruff format"
uv run --package pywire-parser --extra dev ruff format --check src/ tests/

echo "-> ruff lint"
uv run --package pywire-parser --extra dev ruff check src/ tests/

# TODO: ty check (parser pkg has existing type issues untouched by this branch)

echo "-> pytest"
uv run --package pywire-parser --extra dev pytest tests/
