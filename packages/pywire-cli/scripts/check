#!/bin/sh
set -e

echo "🔍 Running checks for pywire-cli..."

echo "-> ruff format"
uv run --package pywire-cli --extra dev ruff format --check src/ tests/

echo "-> ruff lint"
uv run --package pywire-cli --extra dev ruff check src/ tests/

echo "-> ty"
uv run --package pywire-cli --extra dev ty check src/

echo "-> pytest"
uv run --package pywire-cli --extra dev pytest tests/
