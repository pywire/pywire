#!/bin/sh
set -e

echo "🔍 Running checks for pywire-templates..."

echo "-> ruff format"
uv run --package pywire-templates --extra dev ruff format --check src/

echo "-> ruff lint"
uv run --package pywire-templates --extra dev ruff check src/

echo "-> ty"
uv run --package pywire-templates --extra dev ty check src/

# No tests — template renders are exercised by pywire-cli and create-pywire-app.
