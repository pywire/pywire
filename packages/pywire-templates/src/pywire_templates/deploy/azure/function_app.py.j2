"""Azure Functions HTTP entry point for a stateless PyWire app."""
import asyncio
from urllib.parse import urlparse
import azure.functions as func
from pywire.adapters.oneshot import OneShotASGIAdapter
from {{ app_module }} import {{ app_attr }} as _pywire_app
import _routes  # noqa: F401

function_app = func.FunctionApp()
_adapter = OneShotASGIAdapter(_pywire_app)

# The worker binds the request to a parameter named "req" (the route()
# default trigger_arg_name) and skips the function if the names differ.
@function_app.route(route="{*path}", methods=["GET", "POST"], auth_level=func.AuthLevel.ANONYMOUS)
def pywire(req: func.HttpRequest) -> func.HttpResponse:
    parsed = urlparse(req.url)
    status, headers, body = asyncio.run(_adapter.fetch(
        req.method, parsed.path, dict(req.headers), req.get_body(), parsed.query
    ))
    response = func.HttpResponse(body, status_code=status)
    for name, value in headers:  # add(), not a dict: keeps every Set-Cookie
        response.headers.add(name, value)
    return response
