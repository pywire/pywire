"""PyWire app Durable Object: each object runs the whole app.

This module is generated by `pywire build --platform cloudflare`.

The Worker entry sends every request and WebSocket to the object for the
visitor's region (or to one object, with PYWIRE_PLACEMENT = "global"). An
object runs the app the way `pywire run --workers 1` does: page loads, the
WebSocket and long-poll transports all go through the app's own ASGI routes,
each socket gets its own page, and module-level wires are shared by every
visitor it serves. Sockets use the standard (non-hibernating) API, so the
object stays in memory while anyone is connected; hibernation would drop that
shared state.
"""

import asyncio
import os
import sys
from urllib.parse import urlsplit

import asgi
from js import Headers, Object, Request as JsRequest, Response as JsResponse, Uint8Array, WebSocketPair
from pyodide.ffi import create_proxy, to_js
from workers import DurableObject

# Imported here so the deploy-time memory snapshot holds them. The app itself
# is imported on the first request: PyWire() may need randomness (a signing
# secret), which Workers forbid while the script starts, and its settings come
# from `env`, which only exists inside a request.
import msgpack  # noqa: F401
import pywire.runtime.app  # noqa: F401

_HERE = os.path.dirname(os.path.abspath(__file__))
# Sibling imports resolve the way `pywire run {{ app_module }}:{{ app_attr }}` does:
# for src.main, both `src` and modules inside src/ import.
{% set parts = app_module.split(".") -%}
for _dir in [{% for i in range(1, parts | length) %}{{ parts[:i] | join("/") | tojson }}{{ ", " if not loop.last }}{% endfor %}]:
    _path = os.path.join(_HERE, _dir)
    if _path not in sys.path:
        sys.path.insert(0, _path)

_app = None
_tasks = set()


def _load_env(env):
    """Copy Worker vars and secrets into os.environ, where apps read settings.

    Bindings that aren't strings (ASSETS, KV, R2, Durable Objects) are skipped.
    """
    raw = getattr(env, "_env", env)
    for name in Object.keys(raw):
        value = getattr(raw, name, None)
        if isinstance(value, str):
            os.environ.setdefault(name, value)


def _background(coro):
    task = asyncio.ensure_future(coro)
    _tasks.add(task)
    task.add_done_callback(_tasks.discard)
    return task


async def _start_lifespan(app):
    """Run the app's lifespan startup once; the object never shuts it down."""
    started = asyncio.get_running_loop().create_future()
    messages = iter([{"type": "lifespan.startup"}])

    async def receive():
        message = next(messages, None)
        if message is None:
            await asyncio.Event().wait()  # no shutdown while the object lives
        return message

    async def send(message):
        if message["type"] == "lifespan.startup.failed":
            started.set_exception(RuntimeError(message.get("message", "")))
        elif message["type"] == "lifespan.startup.complete":
            started.set_result(None)

    _background(app({"type": "lifespan", "asgi": {"version": "3.0"}, "state": {}}, receive, send))
    await started


async def _import_app(env):
    _load_env(env)
    # _routes.py registers the prebuilt pages: PyWire() must not compile
    # src/pages.
    os.environ["PYWIRE_PREBUILT"] = "1"
    from {{ app_module }} import {{ app_attr }}
    import _routes  # noqa: F401 — registers routes as a side effect

    await _start_lifespan({{ app_attr }})
    return {{ app_attr }}


async def _load_app(env):
    # Requests to one object interleave at every await: the first one imports
    # the app and the rest wait for it.
    global _app
    if _app is None:
        _app = asyncio.ensure_future(_import_app(env))
    try:
        return await _app
    except Exception:
        _app = None  # let the next request try again
        raise


class _SkipLifespan:
    """asgi.fetch runs lifespan startup and shutdown around every request.

    The app's lifespan already ran once for this object, and shutting it down
    per request would close the session store under the open sockets.
    """

    def __init__(self, app):
        self.app = app

    async def __call__(self, scope, receive, send):
        if scope["type"] == "lifespan":
            await receive()
            await send({"type": "lifespan.startup.complete"})
            return
        await self.app(scope, receive, send)


def _websocket_scope(request):
    url = urlsplit(request.url)
    headers = request.headers.items() if hasattr(request.headers, "items") else request.headers
    return {
        "type": "websocket",
        "asgi": {"version": "3.0", "spec_version": "2.3"},
        "http_version": "1.1",
        "scheme": "wss" if url.scheme == "https" else "ws",
        "server": (url.hostname or "localhost", url.port or (443 if url.scheme == "https" else 80)),
        "client": ("client", 0),
        "path": url.path,
        "raw_path": url.path.encode(),
        "root_path": "",
        "query_string": url.query.encode(),
        "headers": [(k.lower().encode(), v.encode()) for k, v in headers],
        "subprotocols": [],
        "state": {},
    }


def _open_socket(app, request):
    """Accept a WebSocket and hand it to the app's own ASGI WebSocket route."""
    client, server = WebSocketPair.new().object_values()
    server.accept()
    # Newer compatibility dates deliver binary frames as Blobs by default.
    server.binaryType = "arraybuffer"
    inbox = asyncio.Queue()
    inbox.put_nowait({"type": "websocket.connect"})

    def on_message(event):
        data = event.data
        if isinstance(data, str):
            inbox.put_nowait({"type": "websocket.receive", "text": data})
        else:
            inbox.put_nowait({"type": "websocket.receive", "bytes": Uint8Array.new(data).to_bytes()})

    def on_close(event):
        inbox.put_nowait({"type": "websocket.disconnect", "code": getattr(event, "code", 1005)})

    listeners = {
        "message": create_proxy(on_message),
        "close": create_proxy(on_close),
        "error": create_proxy(on_close),
    }
    for name, listener in listeners.items():
        server.addEventListener(name, listener)

    async def send(message):
        kind = message["type"]
        if kind == "websocket.send":
            if message.get("bytes") is not None:
                server.send(to_js(message["bytes"]))
            else:
                server.send(message["text"])
        elif kind == "websocket.close":
            try:
                server.close(message.get("code", 1000), message.get("reason") or "")
            except Exception:
                pass  # the client already closed

    async def run():
        try:
            await app(_websocket_scope(request), inbox.get, send)
        finally:
            for name, listener in listeners.items():
                server.removeEventListener(name, listener)
                listener.destroy()
            try:
                server.close(1000, "")
            except Exception:
                pass

    _background(run())
    return JsResponse.new(None, status=101, webSocket=client)


async def _serve_http(app, request):
    # Without Accept-Encoding the app doesn't gzip: the Workers runtime
    # compresses the response itself, and would gzip a gzipped body again.
    js_request = request.js_object if hasattr(request, "js_object") else request
    if js_request.headers.has("accept-encoding"):
        headers = Headers.new(js_request.headers)
        headers.delete("accept-encoding")
        js_request = JsRequest.new(js_request, headers=headers)
    return await asgi.fetch(_SkipLifespan(app), js_request, None)


class PyWireAppDO(DurableObject):
    async def fetch(self, request):
        app = await _load_app(self.env)
        if (request.headers.get("Upgrade") or "").lower() == "websocket":
            return _open_socket(app, request)
        return await _serve_http(app, request)
