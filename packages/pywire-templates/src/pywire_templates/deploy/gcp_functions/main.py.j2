"""Google Cloud Functions entry point for a stateless PyWire app."""
import asyncio
import os

# _routes.py registers the prebuilt pages: PyWire() must not compile src/pages.
os.environ["PYWIRE_PREBUILT"] = "1"

from pywire.adapters.oneshot import OneShotASGIAdapter
from {{ app_module }} import {{ app_attr }} as _pywire_app
import _routes  # noqa: F401

_adapter = OneShotASGIAdapter(_pywire_app)

def pywire(request):
    status, headers, body = asyncio.run(_adapter.fetch(
        request.method, request.path, dict(request.headers), request.get_data(), request.query_string.decode()
    ))
    return body, status, headers  # a list, not a dict: keeps every Set-Cookie
