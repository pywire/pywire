name = "{{ project_name }}"
main = "{{ main | default("entry.py") }}"
compatibility_date = "2026-09-01"
compatibility_flags = ["python_workers"]
workers_dev = false
preview_urls = false

[assets]
directory = "./.pywire/deploy/public"
binding = "ASSETS"

[[durable_objects.bindings]]
name = "PYWIRE_APP"
class_name = "PyWireAppDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["PyWireSessionDO"]

# v2: one object runs the whole app; the per-tab session objects are gone.
[[migrations]]
tag = "v2"
deleted_classes = ["PyWireSessionDO"]
new_sqlite_classes = ["PyWireAppDO"]
