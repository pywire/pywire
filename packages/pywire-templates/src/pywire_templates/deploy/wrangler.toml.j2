name = "{{ project_name }}"
main = "entry.py"
compatibility_date = "2025-01-01"
compatibility_flags = ["python_workers"]
workers_dev = false
preview_urls = false

[assets]
directory = "./.pywire/deploy/public"
binding = "ASSETS"

[[durable_objects.bindings]]
name = "PYWIRE_SESSION"
class_name = "PyWireSessionDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["PyWireSessionDO"]
