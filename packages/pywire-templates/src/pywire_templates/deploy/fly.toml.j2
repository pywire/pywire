app = "{{ project_name }}"
primary_region = "ord"

[build]
  dockerfile = "Dockerfile"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true

[env]
  # Session timeout in seconds (default: 1800 = 30 min)
  SESSION_TTL = "1800"

[[vm]]
  memory = "512mb"
  cpus = 1
