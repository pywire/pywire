services:
  - type: web
    name: {{ project_name }}
    runtime: docker
{% if redis_enabled %}
    plan: starter
    envVars:
      - key: REDIS_URL
        fromService:
          name: {{ project_name }}-kv
          type: keyvalue
          property: connectionString
      - key: SESSION_TTL
        value: "1800"  # Session timeout in seconds (default: 30 min)

  - type: keyvalue
    name: {{ project_name }}-kv
    plan: starter
    ipAllowList: []
{% else %}
    plan: free
    envVars:
      - key: SESSION_TTL
        value: "1800"  # Session timeout in seconds (default: 30 min)
{% endif %}
