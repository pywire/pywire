"""PyWire edge worker — stateless, no Durable Objects."""
import importlib
import os
import sys
from urllib.parse import urlparse

from workers import Response, WorkerEntrypoint

from pywire.adapters.oneshot import OneShotASGIAdapter

# Modules every request needs but nothing above imports. Imported here, they
# go into the deploy-time memory snapshot instead of being loaded by each new
# isolate's first request. The app itself can't be: it reads its secret from
# `env`, which only exists inside a request.
for _name in (
    "anyio._backends._asyncio",
    "anyio.lowlevel",
    "anyio.streams.memory",
    "anyio.streams.stapled",
    "starlette.middleware.base",
    "pywire.runtime.attrs",
    "pywire.runtime.escape",
    "pywire.runtime.helpers",
    "pywire.runtime.loader",
    "pywire.runtime.page_resolver",
    "pywire.runtime.session_persist",
    "pywire.runtime.session_store",
    "pywire.runtime.snapshot_codec",
    "pywire.runtime.stateless_handler",
    "pywire.shell",
):
    try:
        importlib.import_module(_name)
    except ImportError:  # renamed in another version: only a slower first request
        pass

# Like `pywire dev`: for an app at src.main, both the bundle root and src/
# are importable, so main.py can import its sibling packages.
_ROOT = os.path.dirname(os.path.abspath(__file__))
_PARTS = "{{ app_module }}".split(".")
for _depth in range(len(_PARTS) - 1, -1, -1):
    _dir = os.path.join(_ROOT, *_PARTS[:_depth])
    if os.path.isdir(_dir) and _dir not in sys.path:
        sys.path.insert(0, _dir)

_adapter = None


def _env_names(env):
    try:
        from js import Object
    except ImportError:  # outside the Workers runtime
        return dir(env)
    # `env` wraps the JS env object, which dir() can't list.
    return [str(name) for name in Object.keys(getattr(env, "_env", env))]


def _load_env(env):
    """Copy Worker vars and secrets (PYWIRE_SECRET_KEY, PYWIRE_BASE_PATH, the
    app's own API keys) into os.environ, where apps read their settings.
    Bindings that aren't strings (ASSETS, KV, R2) are skipped."""
    for name in _env_names(env):
        if not name.isupper():
            continue
        value = getattr(env, name, None)
        if isinstance(value, str):
            os.environ.setdefault(name, value)


def _get_adapter(env):
    # Python Workers expose vars and secrets on `env`, never os.environ, and
    # `env` is only guaranteed inside a request, so the app is built on the
    # first one.
    global _adapter
    if _adapter is None:
        _load_env(env)
        # _routes.py registers the prebuilt pages: PyWire() must not compile
        # src/pages.
        os.environ["PYWIRE_PREBUILT"] = "1"
        from {{ app_module }} import {{ app_attr }}
        import _routes  # noqa: F401

        _adapter = OneShotASGIAdapter({{ app_attr }})
    return _adapter


async def serve(request, env):
    adapter = _get_adapter(env)
    parsed = urlparse(request.url)
    body = b""
    if request.method in ("POST", "PUT", "PATCH"):
        body = await request.bytes()
    headers = {name.lower(): value for name, value in request.headers.items()}
    # The Workers runtime compresses a response whose Content-Encoding is
    # set, so a body the app already gzipped would be gzipped twice.
    headers.pop("accept-encoding", None)
    status, resp_headers, resp_body = await adapter.fetch(
        request.method, parsed.path, headers, body, parsed.query or "")
    # A list, not a dict: keeps every Set-Cookie.
    return Response(resp_body, status=status, headers=list(resp_headers))


class Default(WorkerEntrypoint):
    async def fetch(self, request):
        return await serve(request, self.env)
