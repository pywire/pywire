FROM python:3.12-slim
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

# Run as an unprivileged user that owns only the app directory.
RUN useradd --create-home --uid 10001 pywire && chown -R pywire:pywire /app
USER pywire

# Session timeout in seconds (default: 1800 = 30 min)
ENV SESSION_TTL=1800

EXPOSE 8000
CMD ["uv", "run", "--no-sync", "pywire", "run", "--host", "0.0.0.0", "--port", "8000", "--workers", "{{ workers }}"]
