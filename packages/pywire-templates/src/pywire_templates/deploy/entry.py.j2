"""PyWire Worker entry: every request goes to an app Durable Object.

This module is generated by `pywire deploy --platform cloudflare`. Static
files never reach it: the assets binding serves them first.

Each object runs the whole app, like one `pywire run --workers 1` process.
By default there is one object per Cloudflare region, placed in that region,
so visitors reach an object near them; module-level wires are shared within
a region, as they are within one worker process. Set the Worker var
PYWIRE_PLACEMENT = "global" to run a single object for everyone instead.
"""

from js import Object
from pyodide.ffi import to_js
from workers import WorkerEntrypoint

from pywire_do import PyWireAppDO  # noqa: F401 — the runtime looks the class up here

# Countries Cloudflare's "me" location hint serves; the rest of Asia is "apac".
_MIDDLE_EAST = frozenset(
    {"AE", "BH", "IL", "IQ", "IR", "JO", "KW", "LB", "OM", "PS", "QA", "SA", "SY", "YE"}
)


def region_for(cf):
    """The Durable Object location hint nearest a request, from request.cf.

    Returns None when the request carries no location (local dev).
    """
    continent = getattr(cf, "continent", None) if cf is not None else None
    if not continent:
        return None
    try:
        longitude = float(getattr(cf, "longitude", None) or 0)
    except ValueError:
        longitude = 0.0
    if continent == "NA":
        return "wnam" if longitude < -100 else "enam"
    if continent == "SA":
        return "sam"
    if continent == "EU":
        return "eeur" if longitude >= 20 else "weur"
    if continent == "AS":
        return "me" if getattr(cf, "country", None) in _MIDDLE_EAST else "apac"
    if continent == "AF":
        return "afr"
    return "oc"  # OC, and AN for the few requests from Antarctica


def object_for(namespace, placement, cf):
    """The app object this request belongs to."""
    region = None if placement == "global" else region_for(cf)
    if region is None:
        return namespace.getByName("app")
    options = to_js({"locationHint": region}, dict_converter=Object.fromEntries)
    return namespace.getByName("app-" + region, options)


class Default(WorkerEntrypoint):
    async def fetch(self, request):
        placement = getattr(self.env, "PYWIRE_PLACEMENT", None)
        cf = getattr(request.js_object, "cf", None)
        stub = object_for(self.env.PYWIRE_APP, placement, cf)
        return await stub.fetch(request)
