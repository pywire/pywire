"""PyWire Worker entry: every request goes to the app's Durable Object.

This module is generated by `pywire deploy --platform cloudflare`. Static
files never reach it: the assets binding serves them first.
"""

from workers import WorkerEntrypoint

from pywire_do import PyWireAppDO  # noqa: F401 — the runtime looks the class up here

# One object runs the whole app, so module-level wires are shared by every
# visitor, as under `pywire run --workers 1`.
APP_OBJECT = "app"


class Default(WorkerEntrypoint):
    async def fetch(self, request):
        stub = self.env.PYWIRE_APP.getByName(APP_OBJECT)
        return await stub.fetch(request)
