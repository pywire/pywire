---
from typing import List, Optional, Tuple

from pywire import props
from pywire.auth.context import get_auth_context
from pywire.auth.policy import PolicyContext
from pywire.auth.principal import ANONYMOUS, ClaimsPrincipal


@props
class Props:
    policy: Optional[str] = None
    claims: Optional[List[Tuple[str, str]]] = None


async def _evaluate():
    parent = self._parent_page
    principal = getattr(parent, "user", None) if parent else None
    if not isinstance(principal, ClaimsPrincipal):
        principal = ANONYMOUS

    required_claims = self.claims
    if required_claims:
        for claim_type, claim_value in required_claims:
            want_value = claim_value or None
            if not principal.has_claim(claim_type, want_value):
                return False

    policy_name = self.policy
    if policy_name:
        ctx = get_auth_context()
        if ctx is None:
            return False
        pctx = PolicyContext(
            principal=principal,
            request=getattr(parent, "request", None) if parent else None,
        )
        try:
            return await ctx.engine.evaluate(policy_name, pctx)
        except KeyError:
            return False

    return principal.is_authenticated
---
{$await _evaluate()}
    <slot name="authorizing" />
{$then allowed}
    {$if allowed}
        <slot name="authorized" />
    {$else}
        <slot name="not_authorized" />
    {/if}
{$catch err}
    <slot name="not_authorized" />
{/await}
