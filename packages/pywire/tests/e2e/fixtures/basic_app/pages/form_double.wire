---
import time
from pydantic import BaseModel
from pywire import form

render_count = wire(0)

# Native form state
native_submit_count = wire(0)

# Bound form state
class Note(BaseModel):
    text: str = ""

note = form(Note)
pywire_submit_count = wire(0)

# The render block executes on every render
render_count.value += 1

def handle_native_submit():
    native_submit_count.value += 1

def handle_pywire_submit():
    pywire_submit_count.value += 1
---
<h1 id="form-title">Form Test</h1>
<p id="render-count">Renders: {render_count}</p>

<h2>Native Form</h2>
<p id="native-submit-count">Submits: {native_submit_count}</p>
<form @submit.prevent={handle_native_submit}>
    <input type="text" id="native-input" name="native-input" value="" />
    <button type="submit" id="native-submit-btn">Submit Native Form</button>
</form>

<h2>PyWire Bound Form</h2>
<p id="pywire-submit-count">Submits: {pywire_submit_count}</p>
<form $bind={note} @submit={handle_pywire_submit}>
    <input $bind={note.text} id="pywire-input" />
    <button type="submit" id="pywire-submit-btn">Submit PyWire Form</button>
</form>
