---
from pydantic import BaseModel, Field
from pywire import form

class User(BaseModel):
    name: str = "Alice"
    age: int = Field(30, ge=0)

user_form = form(User)

prim = wire(0)
lst = wire([1, 2, 3])
ns = wire({"a": "alpha", "b": "beta"})
eff_count = wire(0)

@effect
def _side_effect():
    # Write to eff_count based purely on prim.value so we only read prim
    eff_count.value = prim.value * 10

def update_all():
    prim.value += 1
    lst.append(4) # using .append
    # for dicts, assigning a new dict triggers updates
    ns.value = {"a": "gamma", "b": "beta"}

submitted_data = wire(None)

def handle_form_submit(data: User):
    submitted_data.value = data

---
<div>
    <h1>Advanced Reactivity</h1>
    <button id="btn-update-all" @click={update_all}>Update All</button>

    <div id="prim-val">{prim}</div>
    <div id="eff-val">{eff_count}</div>
    <div id="lst-len">{len(lst)}</div>
    <div id="ns-val">{ns['a']}</div>

    <!-- Fields rendered from the model -->
    <h2>Dynamic Bound Form</h2>
    <div id="submitted-data">{json.dumps(submitted_data.value.model_dump()) if submitted_data else "None"}</div>
    <form $bind={user_form} @submit={handle_form_submit}>
        <div id="form-fields">
            <div $for={field in user_form.fields} class="dyn-field" data-name={field.html_name}>
                <label for={field.html_id}>{field.label}</label>
                <input $bind={field} />
                <span class="error-msg" data-for={field.html_name}>{field.error or ""}</span>
            </div>
        </div>
        <button type="submit" id="btn-submit-form">Submit</button>
    </form>
</div>
