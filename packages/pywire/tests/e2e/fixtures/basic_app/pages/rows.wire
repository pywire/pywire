---
from pydantic import BaseModel, Field
from pywire import form, wire

class Item(BaseModel):
    name: str = Field(min_length=1)

class Order(BaseModel):
    customer: str
    items: list[Item] = Field(default_factory=list, max_length=3)

order = form(Order)
done = wire("")

def create(data: Order):
    done.value = f"{data.customer}:" + ",".join(i.name for i in data.items)
---
<form $bind={order} @submit={create}>
  <input $bind={order.customer}>
  {$for row in order.items}
    <fieldset class="row">
      <input $bind={row.name}>
      <button {**row.remove_button}>Remove</button>
    </fieldset>
  {/for}
  <button id="add" {**order.items.add_button}>Add item</button>
  <button id="save" type="submit">Save</button>
</form>
<p id="done">{done}</p>
