---
from pywire import wire, form
from pydantic import BaseModel, Field

# Native Form state
native_captured = wire(None)

def on_native_submit(event):
    # event is FormEventData; it reads like a mapping of the fields
    native_captured.value = f"Captured: {event.get('username')} - {event.get('email')}"

# Bound form state
class UserSchema(BaseModel):
    username: str = Field(..., min_length=3)
    age: int = Field(..., gt=0)

user = form(UserSchema)
comp_captured = wire(None)

def on_comp_submit(data: UserSchema):
    comp_captured.value = f"User: {data.username} (Age: {data.age})"
---
<div id="form-tests">
    <section id="native-form">
        <h2>Native Form (@submit.prevent)</h2>
        <form @submit.prevent={on_native_submit}>
            <input name="username" id="native-user" type="text" placeholder="Username" />
            <input name="email" id="native-email" type="email" placeholder="Email" />
            <button type="submit" id="btn-native-submit">Submit Native</button>
        </form>
        <p id="native-result">{native_captured}</p>
    </section>

    <section id="comp-form">
        <h2>Bound Form ($bind)</h2>
        <form $bind={user} @submit={on_comp_submit} novalidate>
            <div>
                <label>Username: <input $bind={user.username} id="comp-user" /></label>
                <p id="err-user" $show={user.username.error}>{user.username.error}</p>
            </div>
            <div>
                <label>Age: <input $bind={user.age} id="comp-age" /></label>
                <p id="err-age" $show={user.age.error}>{user.age.error}</p>
            </div>
            <button type="submit" id="btn-comp-submit">Submit Component</button>
        </form>

        <button type="submit" form="user" id="btn-manual-submit">Submit from outside the form</button>
        <p id="comp-result">{comp_captured}</p>
    </section>
</div>
