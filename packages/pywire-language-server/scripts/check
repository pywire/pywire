#!/bin/sh -e

# Assumes running from pywire-language-server root
# Usage: ./scripts/check

FILES="src/pywire_language_server"

echo "-> Formatting..."
uv run --package pywire-language-server --extra dev ruff format --check --diff $FILES

echo "-> Type Checking..."
uv run --package pywire-language-server --extra dev ty check $FILES

echo "-> Linting..."
uv run --package pywire-language-server --extra dev ruff check $FILES

echo "-> Testing (Multi-version)..."
# Use uv run to execute nox from dev dependencies
uv run --package pywire-language-server --extra dev nox
