<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ project_name }}</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/static/pywire-brand.css">
</head>
<body>
    <button class="brand-theme-toggle brand-theme-toggle--floating" id="cs-toggle" aria-label="Toggle color scheme">Auto</button>
    <main class="container">
        {$render children}
    </main>
    <script>
    (function(){var t=document.getElementById('cs-toggle'),m=['auto','light','dark'],l={auto:'Auto',light:'Light',dark:'Dark'},i=Math.max(0,m.indexOf(localStorage.getItem('cs')||'auto'));function a(){var s=m[i];document.documentElement.style.colorScheme=s==='auto'?'':s;t.textContent=l[s];}a();t.onclick=function(){i=(i+1)%3;localStorage.setItem('cs',m[i]);a();};})();
    </script>
</body>
</html>
