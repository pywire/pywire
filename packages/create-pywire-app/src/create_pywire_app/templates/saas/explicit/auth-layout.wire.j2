---
from datetime import datetime

# TODO: Replace with real auth middleware
user = {"id": "demo-user", "email": "demo@pywire.dev", "signed_in_at": datetime.utcnow()}

---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ project_name }} | Dashboard</title>
    <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/static/pywire-brand.css">
</head>
<body>
    <header class="brand-header">
        <div class="container brand-nav">
            <a class="brand-mark" href="/dashboard">{{ project_name }}</a>
            <ul class="brand-links">
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/dashboard/settings">Settings</a></li>
            </ul>
            <button class="brand-theme-toggle" id="cs-toggle" aria-label="Toggle color scheme">Auto</button>
        </div>
    </header>
    <main class="container">
        {$render children}
    </main>
    <script>
    (function(){var t=document.getElementById('cs-toggle'),m=['auto','light','dark'],l={auto:'Auto',light:'Light',dark:'Dark'},i=Math.max(0,m.indexOf(localStorage.getItem('cs')||'auto'));function a(){var s=m[i];document.documentElement.style.colorScheme=s==='auto'?'':s;t.textContent=l[s];}a();t.onclick=function(){i=(i+1)%3;localStorage.setItem('cs',m[i]);a();};})();
    </script>
</body>
</html>
