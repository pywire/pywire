!path {
  'home': '/dashboard',
  'settings': '/dashboard/settings'
}
!layout "auth-layout.wire"

---
# Demo data — in a real app, fetched from a database.
settings_sections = [
    {"id": "account", "title": "Account", "description": "Configure your account preferences."},
    {"id": "billing", "title": "Billing", "description": "Manage your subscription and payment methods."},
    {"id": "team", "title": "Team", "description": "Invite and manage team members."},
]

---
<!-- Dashboard home: /dashboard -->
<section $if={path.home} class="brand-hero">
    <span class="brand-eyebrow">Dashboard</span>
    <h1>Welcome back.</h1>
    <p class="brand-lede">Hook this up to your real metrics — billing status, usage, team activity.</p>
    <p><a class="brand-btn" href="/dashboard/settings">Go to settings →</a></p>
</section>
<ul $if={path.home} class="brand-list brand-list--two">
    <li class="brand-card">
        <h3>Active subscription</h3>
        <p>—</p>
    </li>
    <li class="brand-card">
        <h3>Usage this month</h3>
        <p>—</p>
    </li>
</ul>

<!-- Settings: /dashboard/settings -->
<section $if={path.settings} class="brand-hero">
    <span class="brand-eyebrow">Settings</span>
    <h1>Settings</h1>
    <p class="brand-lede">Manage billing, team, and usage.</p>
</section>
<ul $if={path.settings} class="brand-list">
    <li $for={section in settings_sections} $key={section["id"]} class="brand-card">
        <h3>{section["title"]}</h3>
        <p>{section["description"]}</p>
    </li>
</ul>
<p $if={path.settings}><a href="/dashboard">← Back to Dashboard</a></p>
