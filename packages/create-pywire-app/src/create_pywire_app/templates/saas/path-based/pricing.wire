---
import os

stripe_public_key = os.environ.get("STRIPE_PUBLIC_KEY", "")

---
<section class="brand-hero">
    <span class="brand-eyebrow">Pricing</span>
    <h1>Pricing</h1>
    <p class="brand-lede">Set <code>STRIPE_PUBLIC_KEY</code> in your environment to connect Stripe.</p>
</section>
<pre>{stripe_public_key or "STRIPE_PUBLIC_KEY not set"}</pre>
<button class="brand-btn">Start free trial</button>
