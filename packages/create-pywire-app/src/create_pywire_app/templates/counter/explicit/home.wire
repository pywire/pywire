!path "/"
!layout "layout.wire"

---
count = wire(0)

---
<section class="brand-hero">
    <span class="brand-eyebrow">Explicit routing</span>
    <h1>Reactive counter, served from Python.</h1>
    <p class="brand-lede">This page declares its route with <code>!path</code>.</p>
</section>
<div class="brand-counter">
    <span class="brand-counter-value">{count}</span>
    <div class="brand-counter-buttons">
        <button class="brand-btn" @click={count += 1}>Increment</button>
        <button class="brand-btn brand-btn--ghost" @click={count.value = 0}>Reset</button>
    </div>
</div>
