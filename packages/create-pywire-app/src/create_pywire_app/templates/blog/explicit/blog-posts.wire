!path {
  'list': '/posts',
  'detail': '/posts/{slug}'
}
!layout "layout.wire"

---
from pathlib import Path
import sqlite3
import markdown

app_root = Path(__file__).resolve().parent.parent
db_path = app_root / "data" / "blog.db"

connection = sqlite3.connect(db_path)
connection.row_factory = sqlite3.Row
cursor = connection.cursor()

# Fetch posts for list view
posts = cursor.execute(
    "select slug, title from posts order by id desc"
).fetchall() if path.list else []

# Fetch single post for detail view
post = None

if path.detail:
    # slug is guaranteed non-null here due to path matcher
    post = cursor.execute(
        "select title, body from posts where slug = ?",
        (slug,),
    ).fetchone()

---
<!-- List view: /posts -->
<section $if={path.list} class="brand-hero">
    <span class="brand-eyebrow">Archive</span>
    <h1>All posts</h1>
    <p class="brand-lede">Both <code>/posts</code> and <code>/posts/&#123;slug&#125;</code> are served from one file via path-dicts.</p>
</section>
<ul $if={path.list} class="brand-list">
    <li $for={post in posts} $key={post["slug"]}>
        <a class="brand-card" href="/posts/{post['slug']}">
            <h3>{post["title"]}</h3>
            <p>Read the post →</p>
        </a>
    </li>
</ul>

<!-- Detail view: /posts/{slug} -->
<article $if={path.detail} class="brand-prose">
    <h1>{post["title"] if post else "Post not found"}</h1>
    <div>{!html markdown.markdown(post["body"]) if post else "<p>We couldn't find that post.</p>"}</div>
    <p><a href="/posts">← Back to all posts</a></p>
</article>
