# Copy to .env. `pywire dev` and `pywire run` load it before importing the app.

# Generate each with: openssl rand -hex 32
# Signs API tokens and the cursor socket's tickets.
LOCAL_IDP_SECRET=
# Signs the session cookie.
SESSION_SECRET=
# Signs wizard steps between submits. Without it each process makes its own,
# so set it when you run more than one.
# PYWIRE_SECRET_KEY=

# Defaults to SQLite in ./var. Any SQLAlchemy async URL works, for example
# postgresql+asyncpg://user:pass@localhost/taskboard (add asyncpg).
# DATABASE_URL=

# Where avatars are kept. Defaults to ./var/uploads.
# UPLOAD_DIR=
