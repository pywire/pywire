#!/usr/bin/env python3
"""Build (and with --deploy, ship) an example to demo.pywire.dev/<name>.

    examples/scripts/deploy-demo form-builder            # build only
    examples/scripts/deploy-demo form-builder --deploy   # build and deploy
    examples/scripts/deploy-demo site --deploy           # the landing page

Each stateless example becomes its own Cloudflare Worker (pywire-demo-<name>)
on the route demo.pywire.dev/<name>, served under base_path /<name>. The
landing page in examples/demo-site is a static Worker on demo.pywire.dev/*;
Cloudflare picks the more specific example routes first.

The Worker runs the pywire in this checkout, not the one on PyPI, so the demo
shows main. It is built in examples/.deploy/<name>/ with its own pyproject:
the example's dependencies without the CLI, plus pywire from packages/pywire.

Deploying needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID. Secrets are
set once per Worker, not here (see examples/README.md).
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

EXAMPLES = Path(__file__).resolve().parent.parent
ROOT = EXAMPLES.parent
HOST = "demo.pywire.dev"
ZONE = "pywire.dev"

# Examples that run as stateless Workers. realtime needs the shared Durable
# Object target (#385) and taskboard a database, so neither is here yet.
STATELESS = ("edge-stateless", "form-builder")

# Plain vars per Worker, on top of PYWIRE_BASE_PATH. Cloudflare sets
# CF-Connecting-IP itself, so the rate limiter can trust it here.
VARS = {"form-builder": {"CLIENT_IP_HEADER": "cf-connecting-ip"}}


def run(cmd: list[str], cwd: Path, env: dict[str, str] | None = None) -> None:
    print("+", " ".join(cmd), flush=True)
    subprocess.run(cmd, cwd=cwd, env={**os.environ, **(env or {})}, check=True)


def worker_dependencies(example: Path) -> list[str]:
    """The example's runtime dependencies, minus pywire's CLI extra."""
    project = tomllib.loads((example / "pyproject.toml").read_text())["project"]
    deps = []
    for dep in project.get("dependencies", []):
        m = re.match(r"^pywire(\[([^\]]*)\])?(.*)$", dep)
        if m:
            extras = [e.strip() for e in (m.group(2) or "").split(",")]
            extras = [e for e in extras if e and e != "cli"]
            dep = "pywire" + (f"[{','.join(extras)}]" if extras else "")
        deps.append(dep)
    return deps


def toml_str(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def build(name: str) -> Path:
    example = EXAMPLES / name
    stage = EXAMPLES / ".deploy" / name
    base = f"/{name}"
    if stage.exists():
        shutil.rmtree(stage)
    stage.mkdir(parents=True)
    for part in ("src", "static"):
        if (example / part).is_dir():
            shutil.copytree(
                example / part,
                stage / part,
                ignore=shutil.ignore_patterns("__pycache__", "*.pyc"),
            )

    deps = ", ".join(toml_str(d) for d in worker_dependencies(example))
    pywire_path = toml_str(str(ROOT / "packages" / "pywire"))
    (stage / "pyproject.toml").write_text(
        f"""[project]
name = "pywire-demo-{name}"
version = "0.0.0"
requires-python = ">=3.12"
dependencies = [{deps}]

[dependency-groups]
dev = ["workers-py"]

[tool.uv.sources]
pywire = {{ path = {pywire_path} }}
"""
    )

    # The build imports the app, which reads these; the real secret is a
    # Worker secret and never touches the build.
    env = {
        "PYWIRE_BASE_PATH": base,
        "PYWIRE_SECRET_KEY": "build-only-key-not-used-at-runtime-000",
    }
    run(
        [
            "uv",
            "run",
            "--project",
            str(ROOT),
            "--package",
            f"example-{name}",
            "pywire",
            "build",
            "--platform",
            "cloudflare-edge",
        ],
        cwd=stage,
        env=env,
    )

    wrangler = (stage / "wrangler.toml").read_text()
    routes = ", ".join(
        f"{{ pattern = {toml_str(HOST + pattern)}, zone_name = {toml_str(ZONE)} }}"
        for pattern in (base, base + "/*")
    )
    wrangler = re.sub(
        r'^name = ".*"$', f'name = "pywire-demo-{name}"', wrangler, count=1, flags=re.M
    )
    # Top-level keys have to come before the first [table].
    head, sep, tables = wrangler.partition("\n[")
    variables = {"PYWIRE_BASE_PATH": base, **VARS.get(name, {})}
    wrangler = (
        head.rstrip()
        + f"\nroutes = [{routes}]\n"
        + sep
        + tables.rstrip()
        + "\n\n[vars]\n"
        + "".join(f"{key} = {toml_str(value)}\n" for key, value in variables.items())
    )
    (stage / "wrangler.toml").write_text(wrangler)
    print(f"Built {name} in {stage.relative_to(ROOT)}")
    return stage


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("name", choices=(*STATELESS, "site"))
    parser.add_argument("--deploy", action="store_true")
    args = parser.parse_args()

    if args.name == "site":
        if args.deploy:
            run(["npx", "--yes", "wrangler@4", "deploy"], cwd=EXAMPLES / "demo-site")
        return 0

    stage = build(args.name)
    if args.deploy:
        run(["uv", "run", "--with", "workers-py", "pywrangler", "deploy"], cwd=stage)
    return 0


if __name__ == "__main__":
    sys.exit(main())
