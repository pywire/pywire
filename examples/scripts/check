#!/bin/sh -e
# Full gate for every example: format, lint, pywire check, tests.
# Each example is a uv workspace member named example-<dir>.

cd "$(dirname "$0")/.."

for dir in */; do
    dir="${dir%/}"
    [ -f "$dir/pyproject.toml" ] || continue
    pkg="example-$dir"
    echo "--- $dir ---"
    (
        cd "$dir"
        uv run --package "$pkg" ruff format --check --diff .
        uv run --package "$pkg" ruff check .
        uv run --package "$pkg" pywire check
        if [ -d tests ]; then
            uv run --package "$pkg" pytest -q
        fi
    )
done
