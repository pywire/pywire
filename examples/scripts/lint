#!/bin/sh -e
# Format and lint every example.

cd "$(dirname "$0")/.."

for dir in */; do
    dir="${dir%/}"
    [ -f "$dir/pyproject.toml" ] || continue
    (
        cd "$dir"
        uv run --package "example-$dir" ruff format --check --diff .
        uv run --package "example-$dir" ruff check .
    )
done
