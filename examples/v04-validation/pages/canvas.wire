!path "/canvas"

---
from pywire import ref, wire
from pywire.core.refs import CanvasElement

canvas_ref = ref[CanvasElement]()
data_url_preview = wire("(not captured yet)")
url_length = wire(0)

def request_url(self):
    canvas_ref.request_data_url("image/png")
    data_url_preview.value = "(waiting for client response…)"

@after_update
def capture_url(self):
    url = canvas_ref.data_url
    if url and not url_length.value:
        url_length.value = len(url)
        data_url_preview.value = url[:80] + "…" if len(url) > 80 else url
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>CanvasElement Ref — v0.4</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
    h1 { color: #6366f1; }
    canvas { border: 2px solid #6366f1; border-radius: 4px; display: block; margin: 1rem 0; }
    button { padding: .5rem 1.2rem; background: #6366f1; color: white; border: none; border-radius: 4px; cursor: pointer; margin: .3rem; }
    .result { background: #f0fdf4; border: 1px solid #86efac; border-radius: 4px; padding: .5rem; margin-top: .5rem; font-family: monospace; word-break: break-all; }
    .back { color: #6366f1; text-decoration: none; font-size: .9rem; }
  </style>
</head>
<body>
  <a class="back" href="/">← Back</a>
  <h1>CanvasElement Ref</h1>
  <p>Draw on the canvas, then click "Request Data URL" to capture it server-side.</p>

  <canvas $ref={canvas_ref} id="test-canvas" width="200" height="150"></canvas>

  <div>
    <button id="draw-btn" onclick="drawOnCanvas()">Draw (client-side)</button>
    <button id="request-url-btn" @click={request_url}>Request Data URL</button>
  </div>

  <div class="result" id="data-url-preview">Preview: {data_url_preview}</div>
  <div class="result" id="url-length">URL length: {url_length} chars</div>

  <script>
    function drawOnCanvas() {
      var canvas = document.getElementById('test-canvas');
      var ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#6366f1';
      ctx.fillRect(10, 10, 80, 60);
      ctx.fillStyle = '#f59e0b';
      ctx.beginPath();
      ctx.arc(150, 75, 40, 0, 2 * Math.PI);
      ctx.fill();
      ctx.fillStyle = '#22c55e';
      ctx.font = '16px system-ui';
      ctx.fillText('v0.4', 70, 130);
    }
    // Draw immediately so the canvas isn't blank on load
    document.addEventListener('DOMContentLoaded', function() {
      drawOnCanvas();
    });
  </script>
</body>
</html>
