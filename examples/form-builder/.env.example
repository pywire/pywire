# Copy to .env. `pywire dev` and `pywire run` load it before importing the app.

# OpenRouter writes the fields: https://openrouter.ai/settings/keys
# Free models need "free endpoints that may train on inputs" allowed in
# https://openrouter.ai/settings/privacy
OPENROUTER_API_KEY=
# Jev decides each field's type: https://typesafe.ai
TYPESAFE_API_KEY=

# Signs the page state the browser holds in stateless mode (at least 32 bytes).
# Generate with: openssl rand -hex 32
PYWIRE_SECRET_KEY=

# 0 runs the WebSocket tier instead of stateless.
# STATELESS=1

# Behind Cloudflare, rate-limit by the real client IP.
# CLIENT_IP_HEADER=cf-connecting-ip

# Builds, refines and sample fills per visitor (cookie) and per IP, per window.
# VISITOR_LIMIT=10
# IP_LIMIT=30
# LIMIT_WINDOW=600

# OpenRouter models to try in order, comma separated (default in settings.py).
# WRITER_MODELS=qwen/qwen3.8-27b:free,deepseek/deepseek-v4-flash
# JEV_MODEL=jev-latest
