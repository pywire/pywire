# Copy to .env. `pywire dev` and `pywire run` load it before importing the app.

# Groq writes the fields (free plan works): https://console.groq.com/keys
GROQ_API_KEY=
# Jev decides each field's type: https://typesafe.ai
TYPESAFE_API_KEY=

# Signs the page state the browser holds in stateless mode (at least 32 bytes).
# Generate with: openssl rand -hex 32
PYWIRE_SECRET_KEY=

# 0 runs the WebSocket tier instead of stateless.
# STATELESS=1

# Behind Cloudflare, rate-limit by the real client IP.
# CLIENT_IP_HEADER=cf-connecting-ip

# Builds, refines and sample fills per visitor (cookie) and per IP, per window.
# VISITOR_LIMIT=10
# IP_LIMIT=30
# LIMIT_WINDOW=600

# WRITER_MODEL=openai/gpt-oss-120b
# HELPER_MODEL=openai/gpt-oss-20b
# JEV_MODEL=jev-latest
