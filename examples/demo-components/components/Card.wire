---
from pywire import props

@props
class Props:
    title: str = 'Card Title'
---

<style scoped>
.card { border: 1px solid #ccc; padding: 10px; }
.header { font-weight: bold; border-bottom: 1px solid #eee; }
</style>

<div class="card">
    <div class="header">
        {$render header}Default Header{/render}
    </div>
    <div class="body">
        {$render children}
    </div>
</div>
