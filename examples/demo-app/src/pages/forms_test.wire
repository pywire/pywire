!path "/forms_test"

---
import asyncio
import json
from datetime import date, timedelta
from enum import Enum
from typing import Literal, Optional

from pydantic import BaseModel, EmailStr, Field, ValidationInfo, field_validator, model_validator
from pywire import form
from pywire.forms import FileUpload

# -------------------------------------------------------
# A) Plain form: raw form data, no validation
# -------------------------------------------------------
native_result = wire("")

async def handle_native_submit(data):
    native_result.value = json.dumps(dict(data), indent=2)

# -------------------------------------------------------
# B) Custom validators
# -------------------------------------------------------
class Registration(BaseModel):
    username: str = Field(min_length=3, max_length=20, pattern=r"^[A-Za-z]+$")
    email: EmailStr
    age: int = Field(ge=18, le=100)
    has_referral: bool = False
    referral_code: Optional[str] = Field(None, pattern=r"^[A-Z0-9]{6,12}$")

    @field_validator("email")
    @classmethod
    def corporate_email(cls, v: str) -> str:
        if not v.endswith("@corp.com"):
            raise ValueError("Only @corp.com emails are allowed")
        return v

    @field_validator("referral_code")
    @classmethod
    def code_when_referred(cls, v: Optional[str], info: ValidationInfo) -> Optional[str]:
        if info.data.get("has_referral") and not v:
            raise ValueError("Enter your referral code")
        return v

registration = form(Registration)
registered = wire("")

async def handle_registration(data: Registration):
    registered.value = f"Registered {data.username} ({data.email}), age {data.age}"

# -------------------------------------------------------
# C) Nested model
# -------------------------------------------------------
class ContactAddress(BaseModel):
    street: str
    city: str

    @field_validator("city")
    @classmethod
    def city_uppercase(cls, v: str) -> str:
        if v != v.upper():
            raise ValueError("City must be uppercase (e.g. NYC, LA)")
        return v

class Contact(BaseModel):
    name: str
    address: ContactAddress

contact = form(Contact)
contact_saved = wire("")

async def handle_contact(data: Contact):
    contact_saved.value = f"Contact: {data.name}, {data.address.street}, {data.address.city}"

# -------------------------------------------------------
# D) Choices, dates and files
# -------------------------------------------------------
class Role(str, Enum):
    ADMIN = "admin"
    USER = "user"
    GUEST = "guest"

class Profile(BaseModel):
    full_name: str
    role: Role = Role.USER
    birth_date: date
    interests: list[Literal["python", "web", "data"]] = []
    profile_pic: Optional[FileUpload] = None
    attachments: list[FileUpload] = Field(default_factory=list, max_length=3)

profile = form(Profile)
profile_saved = wire("")

def _summarize(upload: Optional[FileUpload]):
    return None if upload is None else f"{upload.filename} ({upload.size} bytes)"

async def handle_profile(data: Profile):
    profile_saved.value = json.dumps(
        {
            "full_name": data.full_name,
            "role": data.role.value,
            "birth_date": data.birth_date.isoformat(),
            "interests": data.interests,
            "profile_pic": _summarize(data.profile_pic),
            "attachments": [_summarize(a) for a in data.attachments],
        },
        indent=2,
    )

# -------------------------------------------------------
# E) Rules that depend on other fields and server state
# -------------------------------------------------------
class Shipment(BaseModel):
    delivery_method: Literal["standard", "express", "pickup"] = "standard"
    street: Optional[str] = None
    city: Optional[str] = None
    zip: Optional[str] = Field(None, pattern=r"^[0-9]{5}$")
    delivery_date: Optional[date] = None

    @model_validator(mode="after")
    def address_unless_pickup(self, info: ValidationInfo) -> "Shipment":
        if self.delivery_method != "pickup" and not (self.street and self.city and self.zip):
            raise ValueError("Enter a street, city and ZIP code, or choose Store Pickup")
        if self.delivery_method == "express":
            earliest = info.context["earliest"]
            if self.delivery_date is None or self.delivery_date < earliest:
                raise ValueError(f"Express delivery starts on {earliest.isoformat()}")
        return self

shipment = form(Shipment, context=lambda: {"earliest": date.today() + timedelta(days=1)})
delivery_method = wire("standard")
shipment_saved = wire("")

def update_delivery_method(event):
    delivery_method.value = event.value

async def create_shipment(data: Shipment):
    shipment_saved.value = f"Shipment created: {data.delivery_method}, {data.street}, {data.delivery_date}"

def reset_all():
    for f in (registration, contact, profile, shipment):
        f.reset()
    for w in (native_result, registered, contact_saved, profile_saved, shipment_saved):
        w.value = ""
    delivery_method.value = "standard"

# -------------------------------------------------------
# F) Long-running task (unrelated to forms)
# -------------------------------------------------------
task_progress = wire(0)
task_status_text = wire("Idle")
task_running = wire(False)

async def run_long_task():
    if task_running:
        return
    task_running.value = True
    task_progress.value = 0
    task_status_text.value = "Initializing task..."
    await self.push_state()
    total_steps = 50
    for i in range(1, total_steps + 1):
        await asyncio.sleep(0.05)
        task_progress.value = (i / total_steps) * 100
        task_status_text.value = f"Processing item {i} of {total_steps}..."
        if i % 2 == 0:
            await self.push_state()
    task_status_text.value = "Task Completed Successfully!"
    task_progress.value = 100
    task_running.value = False
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>pywire Forms Demo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">
    <style>
        .error { color: #d93526; font-size: 0.875rem; margin-top: 0.25rem; display: block; }
    </style>
</head>
<body>
    <main class="container">
        <h1>Forms Demo</h1>
        <button type="button" class="secondary" @click={reset_all}>Reset every form</button>

        <!-- A plain <form> stays plain: the handler gets the raw fields. -->
        <h2>A) Plain form</h2>
        <form @submit.prevent={handle_native_submit}>
            <label>Username <input name="username" required /></label>
            <label>Email <input name="email" type="email" required /></label>
            <button type="submit">Submit</button>
        </form>
        <pre $if={native_result}>{native_result}</pre>

        <hr>

        <!-- $bind: the model writes the attributes and the server enforces them. -->
        <h2>B) Bound form with custom validators</h2>
        <p><em>username</em> is letters only; <em>email</em> must end with @corp.com; a referral needs a code.</p>
        <article $if={registered}>{registered}</article>
        <form $bind={registration} @submit={handle_registration} $if={not registered}>
            <label>
                {registration.username.label}
                <input $bind={registration.username} autocomplete="username" />
                <small class="error" id={registration.username.error_id} $if={registration.username.error}>{registration.username.error}</small>
            </label>
            <label>
                {registration.email.label}
                <input $bind={registration.email} />
                <small class="error" id={registration.email.error_id} $if={registration.email.error}>{registration.email.error}</small>
            </label>
            <label>
                Age (18-100)
                <input $bind={registration.age} />
                <small class="error" id={registration.age.error_id} $if={registration.age.error}>{registration.age.error}</small>
            </label>
            <label>
                <input $bind={registration.has_referral} />
                I have a referral code
            </label>
            <label>
                Referral code (6-12 uppercase letters or digits)
                <input $bind={registration.referral_code} />
                <small class="error" id={registration.referral_code.error_id} $if={registration.referral_code.error}>{registration.referral_code.error}</small>
            </label>
            <button type="submit">Register</button>
        </form>

        <hr>

        <h2>C) Nested model</h2>
        <p><em>address.city</em> must be uppercase.</p>
        <article $if={contact_saved}>{contact_saved}</article>
        <form $bind={contact} @submit={handle_contact} $if={not contact_saved}>
            <label>
                Name
                <input $bind={contact.name} />
                <small class="error" $if={contact.name.error}>{contact.name.error}</small>
            </label>
            <fieldset>
                <legend>Address</legend>
                <label>
                    Street
                    <input $bind={contact.address.street} />
                    <small class="error" $if={contact.address.street.error}>{contact.address.street.error}</small>
                </label>
                <label>
                    City
                    <input $bind={contact.address.city} />
                    <small class="error" $if={contact.address.city.error}>{contact.address.city.error}</small>
                </label>
            </fieldset>
            <button type="submit">Save contact</button>
        </form>

        <hr>

        <h2>D) Choices, dates and files</h2>
        <pre $if={profile_saved}>{profile_saved}</pre>
        <form $bind={profile} @submit={handle_profile} $if={not profile_saved}>
            <label>
                Full name
                <input $bind={profile.full_name} />
                <small class="error" $if={profile.full_name.error}>{profile.full_name.error}</small>
            </label>
            <label>
                Role
                <select $bind={profile.role}></select>
            </label>
            <label>
                Birth date
                <input $bind={profile.birth_date} />
                <small class="error" $if={profile.birth_date.error}>{profile.birth_date.error}</small>
            </label>
            <fieldset>
                <legend>Interests</legend>
                <label $for={option in profile.interests.options}>
                    <input type="checkbox" value={option.value} $bind={profile.interests} />
                    {option.label}
                </label>
            </fieldset>
            <label>
                Profile picture
                <input $bind={profile.profile_pic} accept="image/*" />
            </label>
            <label>
                Attachments (up to 3)
                <input $bind={profile.attachments} />
                <small class="error" $if={profile.attachments.error}>{profile.attachments.error}</small>
            </label>
            <button type="submit">Save profile</button>
        </form>

        <hr>

        <h2>E) Rules across fields and server state</h2>
        <article $if={shipment_saved}>{shipment_saved}</article>
        <form $bind={shipment} @submit={create_shipment} $if={not shipment_saved}>
            <p class="error" $if={shipment.error}>{shipment.error}</p>
            <label>
                Delivery method
                <select $bind={shipment.delivery_method} @change={update_delivery_method}>
                    <option value="standard">Standard shipping</option>
                    <option value="express">Express shipping</option>
                    <option value="pickup">Store pickup</option>
                </select>
            </label>
            <fieldset $if={delivery_method != "pickup"}>
                <legend>Delivery address</legend>
                <label>Street <input $bind={shipment.street} /></label>
                <label>City <input $bind={shipment.city} /></label>
                <label>
                    ZIP code (5 digits)
                    <input $bind={shipment.zip} />
                    <small class="error" $if={shipment.zip.error}>{shipment.zip.error}</small>
                </label>
            </fieldset>
            <label $if={delivery_method == "express"}>
                Delivery date (tomorrow or later)
                <input $bind={shipment.delivery_date} />
            </label>
            <button type="submit">Submit order</button>
        </form>

        <hr>

        <h2>F) Long-running task</h2>
        <div style="background: #f0f0f0; padding: 20px; border-radius: 8px;">
            <p>Task Status: <strong>{task_status_text}</strong></p>
            <progress value={task_progress} max="100" style="width: 100%; height: 20px;"></progress>
            <div style="margin-top: 10px;">
                <button @click={run_long_task} disabled={task_running}>
                    { 'Running...' if task_running else 'Start Long Task' }
                </button>
            </div>
        </div>
    </main>
</body>
</html>
