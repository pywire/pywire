{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/pre-git-check.sh\"",
            "timeout": 900,
            "statusMessage": "Running checks before git commit/push"
          }
        ]
      }
    ]
  }
}
