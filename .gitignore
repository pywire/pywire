packages/tree-sitter-pywire/*.wasm

# ─────────────────────── Docs ────────────────────────
docs/public/sw.js
docs/public/pywire-worker.js

# ─────────────────────── Certs ───────────────────────
localhost.pem
localhost-key.pem

